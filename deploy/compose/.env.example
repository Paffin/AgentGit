# Copy to `.env` and replace every value. Generate secrets with:  openssl rand -hex 32
# `.env` is git-ignored. Never commit real values.

# First administrator credential (>= 32 characters). Use it once to create users and
# roles, then mint scoped credentials and stop using it.
AG_BOOTSTRAP_TOKEN=

# Bearer token Prometheus uses to read /metrics. Also write the same value to
# secrets/metrics_token (no trailing newline) when using the observability profile.
AG_METRICS_TOKEN=

POSTGRES_PASSWORD=

# MinIO root credentials. The server uses them as its S3 credentials too; for anything
# beyond a single-host trial create a dedicated MinIO user limited to the bucket.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Only for `--profile observability`.
GRAFANA_ADMIN_PASSWORD=

# Optional: headers sent to the trace collector, `name=value,name2=value2`.
# OTEL_EXPORTER_OTLP_HEADERS=

# Optional: pin the server image.
# AG_IMAGE=ghcr.io/paffin/agentgit-server
# AG_VERSION=0.1.0
