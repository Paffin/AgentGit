{
  "uid": "agentgit-overview",
  "title": "AgentGit overview",
  "tags": [
    "agentgit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by result",
      "description": "`ok` is success; `not_found`, `permission_denied`\u2026 are caller errors; `internal`, `unavailable`, `deadline_exceeded` are server-side.",
      "datasource": {
        "type": "prometheus",
        "uid": "agentgit-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(agwp_requests_total[$__rate_interval]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "agentgit-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server-side error ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "agentgit-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agwp_requests_total{code=~\"internal|unavailable|deadline_exceeded|unimplemented\"}[$__rate_interval])) / sum(rate(agwp_requests_total[$__rate_interval]))",
          "legendFormat": "error ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "agentgit-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (all operations)",
      "description": "Long-poll operations (jobs.claim, stream.head, events.subscribe) wait by design and are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "agentgit-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(agwp_request_duration_seconds_bucket{operation!~\"jobs.claim|stream.head|events.subscribe\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "agentgit-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agwp_request_duration_seconds_bucket{operation!~\"jobs.claim|stream.head|events.subscribe\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "agentgit-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(agwp_request_duration_seconds_bucket{operation!~\"jobs.claim|stream.head|events.subscribe\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "agentgit-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slowest operations (p95)",
      "description": "Long-poll operations (jobs.claim, stream.head, events.subscribe) wait by design and are excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "agentgit-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, operation) (rate(agwp_request_duration_seconds_bucket{operation!~\"jobs.claim|stream.head|events.subscribe\"}[$__rate_interval]))))",
          "legendFormat": "{{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "agentgit-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
