
use builtin;
use str;

set edit:completion:arg-completer[ag] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'ag'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'ag'= {
            cand -C 'Operate on the repository at this path (default: discovered from the current directory)'
            cand --repo 'Operate on the repository at this path (default: discovered from the current directory)'
            cand --as 'Act as this identity (`user:alice`, `agent:bot#run_…`, `service:ci`). Also: AG_IDENTITY'
            cand --color 'Colour the output: auto (a terminal, unless NO_COLOR is set), always or never'
            cand --json 'Machine-readable JSON output'
            cand -q 'Print only what was asked for: no confirmations or hints. Errors and refusals are still shown'
            cand --quiet 'Print only what was asked for: no confirmations or hints. Errors and refusals are still shown'
            cand -v 'Explain what is happening on standard error: repository, identity, remote, timing'
            cand --verbose 'Explain what is happening on standard error: repository, identity, remote, timing'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand init 'Create a repository in the current directory'
            cand status 'Summarize the workspace, your proposals, leases, task and remote at a glance'
            cand snapshot 'Record the working directory as a new snapshot'
            cand sync 'Bring the stream''s latest head into the workspace'
            cand log 'Show history'
            cand show 'Show one changeset and what it changed'
            cand diff 'Show differences between two revisions, or the working directory and its snapshot'
            cand cat 'Print a file as of a revision: `ag cat main:src/lib.rs`'
            cand blame 'Show which changeset introduced each line of a file'
            cand ls 'List a directory as of a revision'
            cand checkout 'Write a revision''s files into a new directory'
            cand portability 'List what a revision contains that Windows, macOS or Linux file systems cannot hold'
            cand stream 'Manage streams'
            cand propose 'Publish a snapshot and open a proposal to integrate it'
            cand proposal 'List, review, update or close proposals'
            cand integrate 'Integrate a proposal into its stream'
            cand preview 'Show what integrating a proposal would do, without doing it'
            cand op 'Inspect or resume operations'
            cand recover 'Resume interrupted operations and expire stale ones'
            cand queue 'The ordered integration queue'
            cand policy 'Show or change stream policy'
            cand validate 'Run checks and issue signed attestations'
            cand agent 'Agent identities and runs'
            cand task 'Tasks and their dependencies'
            cand lease 'Soft and exclusive leases with fencing tokens'
            cand provenance 'Signed provenance of agent-made changes'
            cand predict 'Predict overlapping work'
            cand workspace 'Create, list and remove workspaces (isolated lines of work in their own directories)'
            cand trace 'Show the audit trail of an object, proposal, run or stream'
            cand audit 'Verify the tamper-evident audit chain'
            cand verify 'Check the integrity of the whole repository'
            cand gc 'Delete unreachable objects (safe: fails closed, honours a grace period)'
            cand reindex 'Rebuild derived indexes from the object store'
            cand backup 'Write a verified, consistent copy of the repository to a new directory'
            cand git 'Import from or export to Git (needs the `git` command)'
            cand clone 'Clone a repository from an `ag-server`'
            cand fetch 'Download new history from the server'
            cand pull 'Fetch, then fast-forward the local stream and bring the workspace up to date'
            cand push 'Upload your snapshot and open a proposal on the server'
            cand remote 'Manage remotes and work with proposals, events and policy on a server'
            cand pin 'Pin a revision so garbage collection keeps it'
            cand unpin 'Remove a pin'
            cand pins 'List pins'
            cand doctor 'Check the installation, the repository, your identity and every remote''s credential'
            cand config 'Show, get, set and locate configuration (the user file; the repository''s settings are shown read-only)'
            cand completions 'Print a shell completion script: bash, zsh, fish, powershell or elvish'
            cand man 'Print the man page, or write one page per command with --dir'
            cand version 'Print the version, the protocol and the JSON schema version'
            cand help 'Show help for a command, or a topic: workflow, policy, leases, identities, revisions, exit-codes, json, config'
        }
        &'ag;init'= {
            cand --namespace 'Repository namespace, e.g. `acme/webapp` (default: `local/<directory name>`)'
            cand --stream 'Name of the first stream'
            cand --storage 'JSON file with the `storage` section (PostgreSQL metadata and/or S3 objects); see docs/operations/postgres-and-s3.md. Default: a SQLite file and local objects under `.ag/`'
            cand -C 'Operate on the repository at this path (default: discovered from the current directory)'
            cand --repo 'Operate on the repository at this path (default: discovered from the current directory)'
            cand --as 'Act as this identity (`user:alice`, `agent:bot#run_…`, `service:ci`). Also: AG_IDENTITY'
            cand --color 'Colour the output: auto (a terminal, unless NO_COLOR is set), always or never'
            cand --json 'Machine-readable JSON output'
            cand -q 'Print only what was asked for: no confirmations or hints. Errors and refusals are still shown'
            cand --quiet 'Print only what was asked for: no confirmations or hints. Errors and refusals are still shown'
            cand -v 'Explain what is happening on standard error: repository, identity, remote, timing'
            cand --verbose 'Explain what is happening on standard error: repository, identity, remote, timing'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'ag;status'= {
            cand -w 'Workspace name'
            cand --workspace 'Workspace name'
            cand --dir 'Working directory of the workspace (required for non-default workspaces)'
            cand -C 'Operate on the repository at this path (default: discovered from the current directory)'
            cand --repo 'Operate on the repository at this path (default: discovered from the current directory)'
            cand --as 'Act as this identity (`user:alice`, `agent:bot#run_…`, `service:ci`). Also: AG_IDENTITY'
            cand --color 'Colour the output: auto (a terminal, unless NO_COLOR is set), always or never'
            cand --remote 'Also ask each remote''s server for its current head (needs the network and a credential)'
            cand --json 'Machine-readable JSON output'
            cand -q 'Print only what was asked for: no confirmations or hints. Errors and refusals are still shown'
            cand --quiet 'Print only what was asked for: no confirmations or hints. Errors and refusals are still shown'
            cand -v 'Explain what is happening on standard error: repository, identity, remote, timing'
            cand --verbose 'Explain what is happening on standard error: repository, identity, remote, timing'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
