# What `git diff-tree --raw -z` and `git log -z --format=...` (NUL-terminated fields) print.
mode_file="100644"
mode_exec="100755"
mode_link="120000"
mode_gitlink="160000"
mode_none="000000"
colon=":"
nul="\x00"
status_a=" A\x00"
status_m=" M\x00"
status_d=" D\x00"
sha="0000000000000000000000000000000000000000"
dotgit=".git/config"
big_date="9999999999999999"
neg_date="-5"
