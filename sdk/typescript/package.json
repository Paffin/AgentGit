{
  "name": "@agentgit/client",
  "version": "0.3.0-beta.4",
  "description": "TypeScript client for the AgentGit Wire Protocol (AGWP v1): repositories, proposals, agents, leases, signed provenance and events.",
  "keywords": [
    "agentgit",
    "agwp",
    "scm",
    "agents",
    "client"
  ],
  "license": "Apache-2.0",
  "author": "The AgentGit Authors",
  "homepage": "https://github.com/Paffin/AgentGit/tree/main/sdk/typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paffin/AgentGit.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/Paffin/AgentGit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "check": "npm run generate:check && npm run typecheck && npm run lint && npm run test && npm run verify:package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
